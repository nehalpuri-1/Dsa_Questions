class Solution {
  public:
  
  int priority(char s){
      if(s=='+' or s=='-'){
          return 1;
      }
      else if(s=='*' or s=='/')return 2;
      
      else if(s=='^')return 3;
      
      else{
          return 0;
      }
  }
  
    string infixToPostfix(string& s) {
        stack<string>number;
        stack<char>operators;
        int n=s.length();
        for(int i=0;i<n;i++){
            if(s[i]=='('){
                operators.push(s[i]);
            }
            else if(s[i]==')'){
                while(operators.size()>0 and operators.top()!='('){
                    char ch= operators.top();
                    operators.pop();
                    string b=number.top();
                    number.pop();
                    string a=number.top();
                    number.pop();
                    number.push(a+b+string(1,ch));
                }
                if(operators.size()>0)operators.pop();
            }
            else if(s[i]=='+' or s[i]=='-' or s[i]=='*' or s[i]=='/' or s[i]=='^'){
                if(s[i]=='^'){
                    operators.push(s[i]);
                }
                else{
                    while(operators.size()>0 and priority(operators.top())>=priority(s[i])){
                        char ch=operators.top();
                        operators.pop();
                        string b=number.top();
                        number.pop();
                        string a=number.top();
                        number.pop();
                        number.push(a+b+string(1,ch));
                    }
                    operators.push(s[i]);
                }
            }
            else{
               number.push(string(1,s[i])); 
            }
        }
        while(operators.size()>0){
             char ch=operators.top();
             operators.pop();
             string b=number.top();
             number.pop();
             string a=number.top();
             number.pop();          
             number.push(a+b+string(1,ch));
        }
        
        return number.top();
    }
};
