class Solution {
public:
    string predictPartyVictory(string senate) {
        int n=senate.length();
        
        queue<int>qR;
        queue<int>qD;

        for(int i=0;i<n;i++){
            if (senate[i]=='R')qR.push(i);
            else{
                qD.push(i);
            }
        }
        int index=n;
        while(qR.size()>0 and qD.size()>0){
            if(qR.front()<qD.front()){
                qD.pop();
                qR.pop();
                qR.push(index++);
            }
            else{
                qR.pop();
                qD.pop();
                qD.push(index++);
            }
        }
        return (qR.size()==0)?"Dire":"Radiant";
    }
};
