// Method 2 TC=O(N)
class Solution {
  public:
    vector<int> levelOrder(Node *root) {
      queue<Node*>q;
      vector<int>ans;
      if(root!=NULL)q.push(root);
      
      while(q.size()>0){
          Node* front = q.front();
          q.pop();
          ans.push_back(front->data);
          
          if(front->left!=NULL)q.push(front->left);
          if(front->right!=NULL)q.push(front->right);
      }
      return ans;
    }
};

